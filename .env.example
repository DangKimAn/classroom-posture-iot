# ==============================================================================
# BIẾN MÔI TRƯỜNG DÙNG CHUNG CHO ĐỒ ÁN IOT TƯ THẾ NGỒI (DATA_CONTRACT.md)
# ==============================================================================
# Hướng dẫn: Copy file này thành .env và điền giá trị cụ thể.
# Tuyệt đối KHÔNG commit file .env chứa mật khẩu thật lên Git.

# --- Cấu hình Camera Stream (TV1 -> TV2) ---
CAM_STREAM_URL=http://192.168.1.50/stream

# --- Cấu hình MQTT Broker (TV2 <-> TV3) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=classroom/posture/events
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Cấu hình Backend & Database (TV3) ---
DB_PATH=backend/posture.db
PORT=8000
